{
  "manifest_version": 3,
  "name": "UZ Hover Translator",
  "version": "1.3",
  "description": "Select and hover text to translate it to Uzbek.",
  "permissions": ["storage", "contextMenus"],

  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+T"
      },
      "description": "Belgilangan matnni tarjima qilish"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
